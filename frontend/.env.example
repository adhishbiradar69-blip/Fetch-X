# Frontend environment variables
# Copy this file to .env and adjust values

# Backend API URL — REQUIRED for production deploys (Vercel, Netlify, etc.)
# Locally: leave unset (defaults to http://127.0.0.1:8000)
# On Vercel: set to your deployed backend URL, e.g. https://schoolai-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Backend-only env vars (set on your backend host, NOT in frontend)
# GROQ_API_KEY=your-groq-api-key-here
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# SCHOOLAI_SECRET_KEY=your-jwt-secret-key
# SCHOOLAI_TOKEN_EXPIRE_MINUTES=480
